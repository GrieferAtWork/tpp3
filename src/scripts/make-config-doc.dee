import * from deemon;
import ..parts.config;
import posix;

class Context {
	this = default;
	public final member tppAmalgamationH: string;
	public final member configFilename: string;
}

global final CORE_CONTEXT = Context(
		tppAmalgamationH: "tpp-amalgamation.h",
		configFilename: "parts/config.h");

local SRC_DIR = posix.joinpath(posix.headof(__FILE__), "..");

function loadConfigHeader(filename: string): Bytes -> File
	.open(posix.joinpath(SRC_DIR, filename), "rb")
	.read()
	.unifylines()
	.replace("\\\n", "")
	.decode("utf-8")
	.rstriplines()
	/* Convert
	 * >> #if COND
	 * >> #define FOO 1
	 * >> #else
	 * >> #define FOO 0
	 * >> #endif
	 *
	 * To:
	 * >> #define FOO COND
	 */
	.rereplace(
		r"\n"
		r"\s*#\s*if\b([^\n]+)\n"
		r"\s*#\s*define\s+(\w+)\s+1\s*\n"
		r"\s*#\s*else\b[^\n]*\n"
		r"\s*#\s*define\s+(\2)\s+0\s*\n"
		r"\s*#\s*endif\b[^\n]*\n",
		"\n#define \\2 \\1\n",
	)
	/* Convert
	 * >> #if COND
	 * >> #define FOO X
	 * >> #else
	 * >> #define FOO Y
	 * >> #endif
	 *
	 * To:
	 * >> #define FOO COND ? X : Y
	 */
	.rereplace(
		r"\n"
		r"\s*#\s*if\b([^\n]+)\n"
		r"\s*#\s*define\s+(\w+)\s+([^\n]+)\n"
		r"\s*#\s*else\b[^\n]*\n"
		r"\s*#\s*define\s+\2\s+([^\n]+)\n"
		r"\s*#\s*endif\b[^\n]*\n",
		"\n#define \\2 \\1 ? \\3 : \\4\n",
	);

global final MC_TOKEN_CONFIG_MACROS: {string...} = HashSet.Frozen(
	for (local mc: config.MC_TOKENS)
		f"TPP_HAVE_TOK_{config.tokenName(mc.first)}"
);


global final CONFIG_KIND_CORE = "core"; // Core config
global final CONFIG_KIND_CONF = "conf"; // Overwritable config
global final CONFIG_KIND_WARN = "warn"; // TPP_HAVE_TPP_W_*
global final CONFIG_KIND_COMMON = "common"; // TPP_COMMON_HAVE_*
global final CONFIG_KIND_VALUE = "value"; // TPP_CONFIG_*
global final CONFIG_KIND_TOKEN = "token"; // TPP_HAVE_TOK_*
global final CONFIG_KIND_HOOK_DEFAULT = "hook_default"; // TPP_HOOK_DEFAULT_*
global final CONFIG_KIND_BUILTIN_HOOK = "builtin_hook"; // TPP_HAVE_BUILTIN_*_HOOK
global final CONFIG_KIND_LIMIT = "limit"; // Special API limits config
global final CONFIG_KIND_CLI = "cli"; // TPP_HAVE_CLI_*

global formatDoc;

function normalizePpExpr(expr: string): string {
	expr = expr
		.rereplace(r"/\*.*?\*/", "")
		.rereplace(r"\s+", " ")
		.rereplace(r"\bTPP_HAVE_PROFILE_NOT_MINIMAL\b",
			"(TPP_PROFILE != TPP_PROFILE_MINIMAL)")
		.rereplace(r"\bTPP_HAVE_PROFILE_C_LIKE\b",
			"(TPP_PROFILE == TPP_PROFILE_C || TPP_PROFILE == TPP_PROFILE_CXX)")
		.rereplace(r"\bTPP_HAVE_PROFILE_DEFAULT\b",
			"(TPP_PROFILE == TPP_PROFILE_ALL || TPP_PROFILE == TPP_PROFILE_DEFAULT)")
		.rereplace(r"\bTPP_HAVE_PROFILE_ALL\b",
			"(TPP_PROFILE == TPP_PROFILE_ALL)")
		.rereplace(r"\bTPP_COMMON_CONF_EXT0\b", "TPP_CONF_EXT0")
		.rereplace(r"\bTPP_COMMON_CONF_EXT1\b", "TPP_CONF_EXT1")
		.rereplace(r"\bTPP_COMMON_CONF_FEAT0\b", "TPP_CONF_FEAT0")
		.rereplace(r"\bTPP_COMMON_CONF_FEAT1\b", "TPP_CONF_FEAT1")
		.strip();
	while (expr.startswith("(") && expr.endswith(")") &&
	       expr.findmatch("(", ")", 1) == #expr - 1)
		expr = expr[1:-1].strip();
	return expr;
}

class Config {
	this = default;

	@@Config name (e.g. @"TPP_HAVE_BSE")
	public member name: string;

	@@Config doc string
	public member doc: string;

	@@Config doc string for `@detect` tag
	public member docDetect: string;

	@@Config default value
	public member defaultValue: string;

	@@Default extension name of this feature. Also qualifies features
	@@that can be configured as one of `TPP_CONF_*`
	public member defaultExtensionName: string | none;

	@@True if defined inside of "API limits:"-block
	public member isApiLimit: bool;

	public property kind: string = {
		get(): string {
			if (defaultExtensionName !is none) {
				if (name in MC_TOKEN_CONFIG_MACROS)
					return CONFIG_KIND_TOKEN;
				return CONFIG_KIND_CONF;
			}
			if (isApiLimit)
				return CONFIG_KIND_LIMIT;
			if (name.startswith("TPP_HAVE_TPP_W_"))
				return CONFIG_KIND_WARN;
			if (name.startswith("TPP_COMMON_HAVE_"))
				return CONFIG_KIND_COMMON;
			if (name.startswith("TPP_CONFIG_"))
				return CONFIG_KIND_VALUE;
			if (name.startswith("TPP_HOOK_DEFAULT_"))
				return CONFIG_KIND_HOOK_DEFAULT;
			if (name.startswith("TPP_HAVE_CLI_") || name == "TPP_HAVE_CLI")
				return CONFIG_KIND_CLI;
			if (name.wmatch("TPP_HAVE_BUILTIN_*_HOOK"))
				return CONFIG_KIND_BUILTIN_HOOK;
			return CONFIG_KIND_CORE;
		}
	}

	@@The file that contains the documentation for this config
	public property refFile: string = {
		get(): string {
			local kind = this.kind;
			switch (kind) {
			case CONFIG_KIND_HOOK_DEFAULT:
			case CONFIG_KIND_BUILTIN_HOOK:
				return f"config-hook.md";
			default: break;
			}
			return f"config-{kind}.md";
		}
	}

	public printDesc(currentFile: string, fp: File, context: Context): string {
		print fp: f"## {name}\n"
			f"\n"
			f"{formatDoc(currentFile, doc, context)}\n"
			f"\n"
			f"<details><summary>Details</summary>\n"
			f"\n"
			f"Default:\n"
			f"\n"
			f"```c\n"
			f"{defaultValue}\n"
			f"```\n"
			f"{!defaultExtensionName ? "" :
				f"\n"
				f"Extension name:\n"
				f"\n"
				f"```c\n"
				f"#define TPP_EXTNAME_{name.lsstrip("TPP_HAVE_")} {repr defaultExtensionName[2:]}\n"
				f"```\n"
			}"
			f"{!docDetect ? "" :
				f"\n"
				f"Detect:\n"
				f"\n"
				f"```c\n"
				f"{docDetect}"
				f"...\n"
				f"#endif\n"
				f"```\n"
			}"
			f"</details>\n"
			f"\n"
		,;
	}
}

function _getAvailableConfigs(context: Context): {Config...} {
	local configHeaderData = loadConfigHeader(context.configFilename);
	local i = 0, len = #configHeaderData;
	final local REGION_SEPARATOR = "/************************************************************************/";
	local apiLimitsStart = configHeaderData.find("API limits:");
	local apiLimitsEnd = -1;
	if (apiLimitsStart >= 0) {
		apiLimitsStart = configHeaderData.find(REGION_SEPARATOR, apiLimitsStart) + #REGION_SEPARATOR;
		if (apiLimitsStart >= 0)
			apiLimitsEnd = configHeaderData.index(REGION_SEPARATOR, apiLimitsStart);
	}
	while (i < len) {
		local match = configHeaderData
			.regfind(
				r'\s*#\s*ifndef\s*(TPP_\w*)\b\s*\n+'
				r'\s*#\s*define\s*\1\b([^\n]*/\*\s*"(-f[^"\n]+)"\s*\*/|[^\n]*)\n+'
				r'\s*#\s*endif\b[^\n]*\n+'
				, i);
		if (!match)
			break;
		local parts = (
			for (local lo, hi: match[1:])
				lo is none ? none : configHeaderData[lo:hi]
		).frozen;
		local featureName = parts[0];
		local featureExpr = normalizePpExpr(parts[1]);
		local extensionName = parts[2].strip();
		local commentEnd = match.first.first;
		while (commentEnd && configHeaderData.isspace(commentEnd - 1))
			--commentEnd;
		local comment = "";
		if (configHeaderData.endswith("*/", 0, commentEnd)) {
			local commentStart = configHeaderData.rindex("/*", 0, commentEnd - 2);
			if (!configHeaderData.reendswith(r"#\s*endif\s*", 0, commentStart)) {
				comment = configHeaderData[commentStart + 2:commentEnd - 2]
					.replace("\n * ", "\n")
					.replace("\n *\n", "\n\n")
					.strip();
			}
		} else {
			local origCommentEnd = commentEnd;
			for (;;) {
				local sol = configHeaderData.rfind("\n", 0, commentEnd) + 1;
				local soc = sol;
				while (soc < commentEnd && configHeaderData.isspace(soc))
					++soc;
				if (!configHeaderData.startswith("//", soc))
					break;
				commentEnd = sol;
				while (commentEnd && configHeaderData.isspace(commentEnd - 1))
					--commentEnd;
			}
			if (commentEnd < origCommentEnd) {
				comment = configHeaderData[commentEnd:origCommentEnd]
					.striplines()
					.replace("\n// ", "\n")
					.replace("\n//", "\n")
					.strip();
			}
		}

		local matchIndex = match.first.first;
		if (featureName !in [
			"TPP_PROFILE"
		])  {
			local docBase = comment;
			local docDetect = "";
			local detectMatch = comment.refind(r"\n\s*@\s*detect\s*:\s*");
			if (detectMatch !is none) {
				local detectStart = detectMatch.first;
				local detectEnd = detectMatch.last;
				while (comment.islf(detectStart))
					++detectStart;
				local detectIndent = " " * (detectEnd - detectStart);
				local detectLineStart = detectEnd;
				local detectEnd = comment.find("\n", detectEnd);
				local detectBody = File.Writer(hint: "string");
				while (detectEnd >= 0) {
					++detectEnd;
					detectBody << comment[detectLineStart:detectEnd];
					if (!comment.startswith(detectIndent, detectEnd))
						break;
					detectLineStart = detectEnd + #detectIndent;
					detectEnd = comment.find("\n", detectEnd);
				}
				if (detectEnd < 0) {
					detectBody << comment[detectLineStart:];
					detectEnd = #comment;
				}
				docDetect = detectBody.string;
				if (!docDetect.endswith("\n"))
					docDetect += "\n";
				docBase = comment[:detectStart] + comment[detectEnd:];
			}
			docBase = docBase.rstrip();
			yield Config(
					name: featureName,
					doc: docBase,
					docDetect: docDetect,
					defaultValue: featureExpr,
					defaultExtensionName: extensionName,
					isApiLimit: matchIndex >= apiLimitsStart && matchIndex < apiLimitsEnd
			);
		}
		i = match.first.last;
	}
}

function getAvailableConfigs(context: Context): {Config...} {
	static local cache: {string: {Config...}} = Dict();
	local configFilename = context.configFilename;
	local result = cache.get(configFilename);
	if (result is none)
		result = cache[configFilename] = _getAvailableConfigs(context).cached;
	return result;
}

function getAvailableConfigsByName(context: Context): {string: Config} {
	static local cache: {string: {string: Config}} = Dict();
	local configFilename = context.configFilename;
	local result = cache.get(configFilename);
	if (result is none) {
		result = cache[configFilename] = Dict.Frozen(
			for (local conf: getAvailableConfigs(context))
				{conf.name, conf}
		);
	}
	return result;
}


function _getAmalgamationHLines(context: Context): {string: int} {
	local result: {string: int} = Dict();
	local identPriority: {string: int} = Dict();
	local lastLineEndsWithTPPCALL = false;
	for (local lno, line: File.open(posix.joinpath(SRC_DIR, context.tppAmalgamationH), "rb")
			.read().splitlines(false).enumerate()) {
		local match = line.regmatch(r"^\s*#\s*define\s+(\w+)\b"); /* Macro */
		local prio = 0;
		if (!match) {
			match = line.regfind(r"\bTPPCALL\s+(\w+)\b"); /* Function decl */
			prio = 1;
		}
		if (!match && lastLineEndsWithTPPCALL) {
			match = line.regmatch(r"^\s*(\w+)\s*\("); /* Function decl */
			prio = 1;
		}
		if (!match) {
			match = line.regmatch(r"^\s*(\w+)\s*,\s*/[/*]"); /* Enum */
			prio = 1;
		}
		if (!match) {
			match = line.regmatch(r"^\s*(\w+)\s*="); /* Enum */
			prio = 1;
		}
		if (!match) {
			match = line.regfind(r"\bstruct\s+(\w+)\s*\{"); /* struct */
			prio = 1;
		}
		if (match) {
			local bounds = match[1];
			local ident = line[bounds.first:bounds.last];
			if (ident !in result || identPriority[ident] < prio) {
				result[ident] = lno + 1;
				identPriority[ident] = prio;
			}
		}
		lastLineEndsWithTPPCALL = line.reendswith(r"\bTPPCALL");
	}
	return result;
}

function getAmalgamationHLines(context: Context): {string: int} {
	static local cache: {string: {string: int}} = Dict();
	local tppAmalgamationH: string = context.tppAmalgamationH;
	local result = cache.get(tppAmalgamationH);
	if (result is none)
		result = cache[tppAmalgamationH] = _getAmalgamationHLines(context);
	return result;
}



function formatDoc(currentFile: string, doc: string, context: Context): string {
	doc = doc
		.replace(":\n-", ":\n\n-")
		.replace(":\n```", ":\n\n```");
	for (local i = 0;;) {
		local tick = doc.find("`", i);
		if (tick < 0)
			break;
		local nextTick = doc.find("`", tick + 1);
		if (nextTick < 0)
			break;
		local content = doc[tick + 1:nextTick];
		local confContext = context;
		local conf: Config | none = getAvailableConfigsByName(confContext).get(content);
		if (conf is none && confContext !== CORE_CONTEXT) {
			confContext = CORE_CONTEXT;
			conf = getAvailableConfigsByName(confContext).get(content);
		}
		if (conf !is none) {
			local refFile = currentFile;
			if (confContext === CORE_CONTEXT)
				refFile = conf.refFile;
			local newContent = f'[`{content}`]({
				refFile == currentFile ? "" : refFile
			}#{conf.name.lower()})';
			doc = doc[:tick] + newContent + doc[nextTick+1:];
			nextTick += #newContent - #content;
		} else {
			/* When it's the name of a function/macro from the C API,
			 * then encode a link to `tpp-amalgamation.h#L<lineno>`
			 * here -- since that file is also generated, we can easily
			 * rig "Makefile" to re-generate config docs whenever the
			 * amalgamation is changed, and the online docs will be
			 * easier to navigate in terms of linking between feature
			 * documentation and associated source code. */
			local functionName = content;
			local lparen = functionName.find("(");
			if (lparen >= 0) {
				local rparen = functionName.findmatch("(", ")", lparen + 1);
				if (rparen == #functionName - 1)
					functionName = functionName[:lparen].strip();
			}
			if (functionName.issymbol()) {
				local lineNumberContext = context;
				local lineNumber = getAmalgamationHLines(lineNumberContext).get(functionName);
				if (lineNumber is none && lineNumberContext !== CORE_CONTEXT) {
					lineNumberContext = CORE_CONTEXT;
					lineNumber = getAmalgamationHLines(lineNumberContext).get(functionName);
				}
				if (lineNumber !is none) {
					local newContent = f'[`{content}`](../src/{
						lineNumberContext.tppAmalgamationH}#L{lineNumber})';
					doc = doc[:tick] + newContent + doc[nextTick+1:];
					nextTick += #newContent - #content;
				}
			}
		}
		i = nextTick + 1;
	}
	return doc;
}



function updateConfigMd(filename: string, context: Context) {
	print("Updating ", repr filename);
	local currentFile = filename.rpartition("/").last;
	local oldData = File.open(filename, "rb").read();
	local i = 0, len = #oldData;
	local newData = File.Writer(hint: "bytes");
	while (i < len) {
		local match = oldData.regfind(r"<!--BEGIN:([\w---]+)-->", i);
		if (!match)
			break;
		local tag = oldData[match[1].first: match[1].last];
		local endTag = oldData.find(f"<!--END:{tag}-->", i);
		if (endTag < 0)
			break;
		newData.write(oldData[i:match.first.last]);
		newData.write("\n");
		switch (tag) {

		// Custom handling for specific tags
		case "token":
			newData << "| Token | Config | Extension |\n"
			           "| ----- | ------ | --------- |\n";
			for (local conf: getAvailableConfigs(context)) {
				if (conf.kind == "token") {
					local mcReprFull = conf.name.lsstrip("TPP_HAVE_TOK_");
					local mcRepr = config.MC_TOKENS
						.filter(e -> mcReprFull == config.tokenName(e.first))
						.first.first;
					print newData: f"| `{mcRepr.replace("|", "\\|")}` | <a name=\"{
						conf.name.lower()}\"></a>`{conf.name}` | `{
						conf.defaultExtensionName
					}` (`TPP_EXTNAME_{
						conf.name.lsstrip("TPP_HAVE_")
					}`) |";
				}
			}
			break;

		case "warn":
			for (local conf: getAvailableConfigs(context)) {
				if (conf.kind == "warn")
					print newData: f"- <a name=\"{conf.name.lower()}\"></a>`{conf.name}`";
			}
			break;

		case "builtin_hook":
			for (local conf: getAvailableConfigs(context)) {
				if (conf.kind == "builtin_hook")
					print newData: f"- <a name=\"{conf.name.lower()}\"></a>`{conf.name}`";
			}
			break;

		case "hooks":
			for (local doc, name,
			     default_TPP_HAVE_FOO_HOOK,
			     builtin_FOO_HOOK,
			     prototypePrefix,
			     prototypeSuffix,
			     prototypeArgs,
			     disabled_RETURN_VALUE:
			     config.HOOKS) {
				prototypePrefix, prototypeSuffix = config
					.unPointerizeHook(prototypePrefix, prototypeSuffix)...;
				print newData:
					f"## TPP_HAVE_{name}_HOOK\n"
					f"\n"
					f"```c\n"
					f"{prototypePrefix}TPP_HOOK_{name}{prototypeSuffix};\n"
					f"```\n"
					f"\n"
					f"{formatDoc(currentFile, doc.partition("\n@").first, context)}\n"
					f"\n"
					f"<details><summary>Details</summary>\n"
					f"\n"
					f"Default:\n"
					f"\n"
					f"```c\n"
					f"{normalizePpExpr(default_TPP_HAVE_FOO_HOOK)}\n"
					f"```\n"
					f"\n"
					f"Disabled (mock):\n"
					f"\n"
					f"```c\n"
					f"{prototypePrefix}_tpp_disabled_hook_{name.lower()}{prototypeSuffix} \{\n"
					f"	return {disabled_RETURN_VALUE};\n"
					f"\}\n"
					f"```\n"
					f"{!builtin_FOO_HOOK ? "" :
						f"\n"
						f"Builtin (internal; don't call directly):\n"
						f"\n"
						f"```c\n"
						f"#if TPP_HAVE_BUILTIN_{name}_HOOK\n"
						f"{prototypePrefix}{builtin_FOO_HOOK}{prototypeSuffix};\n"
						f"#endif /* TPP_HAVE_BUILTIN_{name}_HOOK */\n"
						f"```\n"
					}"
					f"</details>\n"
					f"\n"
					f"\n"
				,;
			}
			break;

		case "glossary": {
			local knownFiles = HashSet();
			local isFirst = true;
			for (local conf: getAvailableConfigs(context)) {
				if (!isFirst)
					print newData: " ",;
				isFirst = false;
				local refFile = filename;
				if (context === CORE_CONTEXT)
					refFile = conf.refFile;
				if (refFile !in knownFiles) {
					if (refFile == filename ||
					    posix.stat.isreg(f"{SRC_DIR}/../doc/{refFile}")) {
						knownFiles.insert(refFile);
					} else {
						print newData: f"<!-- ?: {conf.name} -->",;
					}
				}
				if (refFile in knownFiles)
					print newData: f"[`{conf.name}`]({refFile == filename ? "" : refFile}#{conf.name.lower()})",;
			}
			if (context === CORE_CONTEXT) {
				for (local doc, name, default_TPP_HAVE_FOO_HOOK,
				     builtin_FOO_HOOK, prototypePrefix,
				     prototypeSuffix, prototypeArgs,
				     disabled_RETURN_VALUE: config.HOOKS) {
					if (!isFirst)
						print newData: " ",;
					isFirst = false;
					print newData: f"[`TPP_HAVE_{name}_HOOK`](config-hook.md#tpp_have_{name.lower()}_hook)",;
				}
			}
			print newData:;
		}	break;

		case "all":
			for (local conf: getAvailableConfigs(context))
				conf.printDesc(currentFile, newData, context);
			break;

		default: {
			local foundAny = false;
			for (local conf: getAvailableConfigs(context)) {
				if (conf.kind == tag) {
					conf.printDesc(currentFile, newData, context);
					foundAny = true;
				}
			}
			if (!foundAny)
				throw Error(f"Unknown tag: {repr tag}");
		}	break;

		}
		i = endTag;
	}
	newData.write(oldData[i:]);

	newData = newData.bytes;
#if 0 /* Always write newData so "make" won't try to re-run for every file */
	if (newData != oldData)
#endif
	{
		with (local fp = File.open(filename, "wb"))
			fp.write(newData);
	}
}


#ifdef __MAIN__
updateConfigMd(posix.joinpath(SRC_DIR, "../doc/config.md"), CORE_CONTEXT);
updateConfigMd(posix.joinpath(SRC_DIR, "../doc/config-limit.md"), CORE_CONTEXT);
updateConfigMd(posix.joinpath(SRC_DIR, "../doc/config-core.md"), CORE_CONTEXT);
updateConfigMd(posix.joinpath(SRC_DIR, "../doc/config-conf.md"), CORE_CONTEXT);
