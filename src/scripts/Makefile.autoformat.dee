import * from deemon;
import * from posix;

global final FORMAT_CACHE = ".format-cache";

global final SRC_DIR = joinpath(headof(__FILE__), "..");
global final PARTS_DIR = joinpath(SRC_DIR, "parts");

global filesWithDeemonScripts: {string...} = [];
global allFiles: {string...} = [];

@@Rules described within `/*!depends ... */` comments
global dependsOnRules: {string: string} = Dict();

for (local ent: opendir(PARTS_DIR)) {
	if (ent.d_type == DT_REG) {
		local filename = ent.d_name;
		local fileData = File.open(joinpath(PARTS_DIR, filename), "rb").read();
		if ("[[[deemon" in fileData)
			filesWithDeemonScripts.append(filename);
		
		local dependsOnStart = fileData.find("/*!depends");
		if (dependsOnStart >= 0) {
			dependsOnStart += 10;
			local dependsOnEnd = fileData.index("*/", dependsOnStart);
			local dependsOnText = fileData[dependsOnStart:dependsOnEnd].strip().decode("utf-8");
			dependsOnRules[filename] = dependsOnText;
		}
		allFiles.append(filename);
	}
}

@@Return the `#include "parts/..."` filenames performed within @filename
function getPartIncludes(filename: string): {string...} {
	local data = File.open(filename, "rb").read();
	for (local match: data.reglocateall(r'\n\s*#\s*include\s*"parts/([^"]+)"'))
		yield match.last;
}

function printIncludeDependencies(tppH: string, tppAmalgamationH: string) {
	local partIncludes = getPartIncludes(tppH);
	local finalPartIncludes = [];
	for (local partInclude: partIncludes) {
		if (partInclude in filesWithDeemonScripts)
			partInclude = f"{FORMAT_CACHE}/{partInclude}";
		finalPartIncludes.append(f"src/parts/{partInclude}");
	}
	print(f"src/{tppAmalgamationH}: {" ".join(finalPartIncludes)}");
}

function main() {
	for (local filename: filesWithDeemonScripts) {
		local dependencies = [filename];
		local dependsOnRule = dependsOnRules.get(filename, "");
		if (dependsOnRule) {
			local rules = (
				for (local rule: dependsOnRule.split(","))
					rule.strip()
			).frozen;
			for (local allFile: allFiles) {
				if (allFile == filename)
					continue;
				if (!allFile.endswith(".h") && !allFile.endswith(".c"))
					continue;
				if ((for (local rule: rules) allFile.wmatch(rule)) || ...) {
					if (allFile in filesWithDeemonScripts)
						allFile = f"{FORMAT_CACHE}/{allFile}";
					dependencies.append(allFile);
				}
			}
		}
		print(f"src/parts/{FORMAT_CACHE}/{filename}: {" ".join(
			for (local dependency: dependencies)
				f"src/parts/{dependency}"
		)}");
		print(f"	deemon -Wno-usage -Wno-user -F src/parts/{filename}");
		print(f"	@> src/parts/{FORMAT_CACHE}/{filename}");
	}

	printIncludeDependencies(joinpath(SRC_DIR, "tpp.h"), "tpp-amalgamation.h");
	printIncludeDependencies(joinpath(SRC_DIR, "tpp.c"), "tpp-amalgamation.c");
}

#ifdef __MAIN__
main();
#endif /* __MAIN__ */
