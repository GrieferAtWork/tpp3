import * from deemon;
import posix;

@@Remove comments containing [[[deemon]]] scripts
function removeDeemonScripts(data: Bytes): Bytes {
	final local START_MARKER = "/*[[[deemon";
	final local MID_MARKER = "]]]*/";
	final local END_MARKER1 = "/*[[[end]]]*/";
	final local END_MARKER2 = "//[[[end]]]\n";
	while (true) {
		local start = data.find(START_MARKER);
		if (start < 0)
			break;
		local mid = data.index(MID_MARKER, start + #START_MARKER);
		mid += #MID_MARKER;
		while (mid < #data && data.islf(mid))
			++mid;
		local end = data.indexany({END_MARKER1,END_MARKER2}, mid);
		local endEnd = end + (data.startswith("//", end) ? #END_MARKER2 : #END_MARKER1);
		if (endEnd < #data && data.islf(endEnd))
			++endEnd;
		data = data[:start] + data[mid:end] + data[endEnd:];
	}
	return data;
}

function getFile(filename: string): Bytes {
	local data: Bytes;
	with (local fp = File.open(filename, "rb"))
		data = fp.readall();
	local filteredData = File.Writer(hint: "bytes");
	for (local i = 0;;) {
		final local START = "/*[[[tpp-begin]]]*/";
		final local END   = "/*[[[tpp-end]]]*/";
		local start = data.find(START, i);
		if (start < 0)
			break;
		start += #START;
		local end = data.index(END, start);
		while (data.isspace(start))
			++start;
		while (data.isspace(end - 1))
			--end;
		if (i)
			filteredData.write("\n");
		filteredData.write(data[start:end].unifylines());
		i = end;
	}
	data = removeDeemonScripts(filteredData.bytes);
	data = data.replace("/* clang-format off */\n", "");
	data = data.replace("/* clang-format on */\n", "");
	data = data.replace("// clang-format off\n", "");
	data = data.replace("// clang-format on\n", "");
	data = data.rereplace(r"\bTPP_INTERN_(DECL|IMPL)\b([^\n]*)\\\n", "static\\2         \\\\\n");
	data = data.rereplace(r"\bTPP_INTERN_(DECL|IMPL)\b", r"static");
//	data = data.decode("utf-8");
//	data = data.rstriplines(); /* Don't do this -- needed in some places to prevent some "-Wcomment" warnings */
//	data = data.encode("utf-8");
	return data;
}

function removeUnnecessaryDeclBlocks(bytes: Bytes): Bytes {
	local i = 0;
	for (;;) {
		local probe, probeEnd = bytes.refind(r"\bTPP_DECL_END\b", i)...;
		if (probe is none)
			break;
		local nextBegin, nextEnd = bytes.refind(r"\bTPP_DECL_BEGIN\b", probeEnd)...;
		if (nextBegin is none)
			break;
		local between = bytes[probeEnd:nextBegin];
		while (between) {
			between = between.strip();
			if (between.startswith("//")) {
				local end = between.find("\n");
				if (end < 0)
					break;
				between = between[end + 1:];
			} else if (between.startswith("/*")) {
				local end = between.find("*/", 2);
				if (end < 0)
					break;
				between = between[end + 2:];
			} else {
				break;
			}
		}
		if (!between) {
			while (bytes.isspace(probeEnd))
				++probeEnd;
			while (bytes.isspace(nextBegin - 1))
				--nextBegin;
			bytes = bytes[:nextBegin] + bytes[nextEnd:];
			bytes = bytes[:probe] + bytes[probeEnd:];
			nextBegin += nextEnd - nextBegin;
			nextBegin += probeEnd - probe;
		}
		i = nextBegin;
	}
	return bytes;
}

function makeAmalgamation(inputFilename: string, TPP_AMALGAMATION_H: string) {
	local data: Bytes;
	with (local fp = File.open(inputFilename, "rb"))
		data = fp.readall();
	local writer = File.Writer(hint: "bytes");
	local i = 0;
	while (i < #data) {
		local MARKER = '#include "';
		local inc = data.find(MARKER, i);
		if (inc < 0)
			break;
		writer.write(data[i:inc]);
		inc += #MARKER;
		local incEnd = data.index('"', inc);
		local filename = data[inc:incEnd].decode("utf-8");
		local absFilename = posix.joinpath(posix.headof(inputFilename), filename);
		writer.write(f"/************************************************************************/\n"
		             f"/* File: {filename.ljust(63)}*/\n"
		             f"/************************************************************************/\n");
		writer.write(getFile(absFilename)
			.rereplace(r"\bTPP_CONFIG_DEFS_FILENAME\b", TPP_AMALGAMATION_H)
			.strip());
		writer.write("\n");
		i = incEnd + 1;
	}
	writer.write(data[i:]);
	local outData = writer.bytes;
	outData = removeUnnecessaryDeclBlocks(outData);
	File.stdout.write(outData);
}

function main(args: {string...}) {
	makeAmalgamation(args...);
}

#ifdef __MAIN__
main([...][1:]);
#endif /* __MAIN__ */
