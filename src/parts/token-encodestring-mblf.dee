import * from deemon;

function getUnicodeLinefeedCharacters(): {int...} {
#if 1 /* Cached (since enumerating all of unicode is pretty slow) */
	return { 0x85, 0x2028, 0x2029 };
#else
	local result = [];
	for (local ord: [0x80: 0x10ffff+1]) {
		if (string.chr(ord).islf())
			result.append(ord);
	}
	print ", ".join(result.map(e -> e.hex())); /* To update cache above */
	return result.frozen;
#endif
}

global final UNICODE_LF_CHARACTERS = getUnicodeLinefeedCharacters();

function getUtf8LineFeedFirstBytes(): {int...} {
	local result = HashSet();
	for (local ord: UNICODE_LF_CHARACTERS) {
		local b = string.chr(ord).encode("utf-8").first;
		result.insert(b);
	}
	return result.sorted().frozen;
}

global final UTF8_LF_FIRST_BYTES = getUtf8LineFeedFirstBytes();
