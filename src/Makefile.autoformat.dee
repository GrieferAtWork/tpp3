import * from deemon;
import * from posix;

local PARTS_DIR = joinpath(headof(__FILE__), "parts");

local filesWithDeemonScripts: {string...} = [];
local allFiles: {string...} = [];

for (local ent: opendir(PARTS_DIR)) {
	if (ent.d_type == DT_REG) {
		local filename = ent.d_name;
		local fileData = File.open(joinpath(PARTS_DIR, filename), "rb").read();
		if ("[[[deemon" in fileData)
			filesWithDeemonScripts.append(filename);
		allFiles.append(filename);
	}
}

for (local filename: filesWithDeemonScripts) {
	local dependencies = [filename];
	if (filename == "expose-internals.h") {
		for (local allFile: allFiles) {
			if (allFile == filename)
				continue;
			if (allFile.endswith(".h") || allFile.endswith(".c")) {
				if (allFile in filesWithDeemonScripts)
					allFile = f"format-cache/{allFile}";
				dependencies.append(allFile);
			}
		}
	}
	print(f"parts/format-cache/{filename}: {" ".join(
		for (local dependency: dependencies)
			f"parts/{dependency}"
	)}");
	print(f"	deemon -Wno-usage -Wno-user -F parts/{filename}");
	print(f"	@> parts/format-cache/{filename}");
}

@@Return the `#include "parts/..."` filenames performed within @filename
function getPartIncludes(filename: string): {string...} {
	local data = File.open(filename, "rb").read();
	for (local match: data.reglocateall(r'\n\s*#\s*include\s*"parts/([^"]+)"'))
		yield match.last;
}

function printIncludeDependencies(tppH: string, tppAmalgamationH: string) {
	local partIncludes = getPartIncludes(tppH);
	local finalPartIncludes = [];
	for (local partInclude: partIncludes) {
		if (partInclude in filesWithDeemonScripts)
			partInclude = f"format-cache/{partInclude}";
		finalPartIncludes.append(f"parts/{partInclude}");
	}
	print(f"{tppAmalgamationH}: {" ".join(finalPartIncludes)}");
}


printIncludeDependencies("tpp.h", "tpp-amalgamation.h");
printIncludeDependencies("tpp.c", "tpp-amalgamation.c");

