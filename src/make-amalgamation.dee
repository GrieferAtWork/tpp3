import * from deemon;
import posix;

function getFile(filename: string): Bytes {
	local data: Bytes;
	with (local fp = File.open(filename, "rb"))
		data = fp.readall();
	final local START = "/*[[[tpp-begin]]]*/";
	final local END   = "/*[[[tpp-end]]]*/";
	local start = data.index(START) + #START;
	local end   = data.index(END);
	while (data.isspace(start))
		++start;
	while (data.isspace(end - 1))
		--end;
	return data[start:end]
		/* Remove comments containing [[[deemon]]] scripts */
		.rereplace(r"/\*\[\[\[deemon.*\]\]\]\*/\n(.*)/\*\[\[\[end\]\]\]\*/\n", r"\1")
		.rereplace(r"/\*\s*clang-format\s*(on|off)\s*\*/\n", r"")
		;
}

function makeAmalgamation(inputFilename: string, outputFilename: string) {
	local data: Bytes;
	with (local fp = File.open(inputFilename, "rb"))
		data = fp.readall();
	local writer = File.Writer(hint: "bytes");
	local i = 0;
	while (i < #data) {
		local MARKER = '#include "';
		local inc = data.find(MARKER, i);
		if (inc < 0)
			break;
		writer.write(data[i:inc]);
		inc += #MARKER;
		local incEnd = data.index('"', inc);
		local filename = data[inc:incEnd].decode("utf-8");
		local absFilename = posix.joinpath(posix.headof(inputFilename), filename);
		writer.write(f"/************************************************************************/\n"
		             f"/* File: {filename.ljust(63)}*/\n"
		             f"/************************************************************************/\n");
		writer.write(getFile(absFilename));
		writer.write(f"\n/************************************************************************/\n"
		             f"");
		i = incEnd + 1;
	}
	writer.write(data[i:]);
	local outData = writer.bytes;
	/* TODO: Remove "TPP_DECL_END ... TPP_DECL_BEGIN" blocks such that only the
	 *       "..." part is kept (so-long as the "..." part contains only comments) */

	with (local fp = File.open(outputFilename, "wb"))
		fp.write(outData);
}


makeAmalgamation("tpp.h", "tpp-amalgamation.h");
makeAmalgamation("tpp.c", "tpp-amalgamation.c");


